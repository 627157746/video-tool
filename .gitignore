# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Editors / IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
# Cursor MCP configs often hold API keys / tokens — never commit.
.cursor/mcp.json
.cursor/mcp*.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# --- Env & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
**/config.local.toml
**/config.local.json
**/*secret*
!**/*.example
!**/*.example.*

# --- Node / frontend (Tauri UI) ---
node_modules/
dist/
dist-ssr/
.output/
.vite/
.turbo/
.cache/
*.tsbuildinfo
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
# Prefer pnpm only — do not commit other lockfiles
package-lock.json
yarn.lock

# --- Rust / Cargo ---
target/
**/*.rs.bk
Cargo.lock.bak

# --- Tauri ---
src-tauri/target/
src-tauri/gen/schemas/

# --- Python (transcribe sidecars) ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# --- Video-tool workspace & media ---
workspace/*
!workspace/.gitkeep

# Common media containers (do NOT use global *.ts — conflicts with TypeScript)
*.mp4
*.mkv
*.webm
*.flv
*.m4a
*.mp3
*.wav
*.aac
*.mov
*.avi
*.m3u8
*.part
*.ytdl
*.mpegts
workspace/**/*.ts
**/jobs/**/*.ts
**/media/**/*.ts

# --- ML models (root / named dirs only; do NOT ignore src-tauri/src/models) ---
/models/
*.gguf
*.onnx
*.pt
*.pth
*.safetensors
/models/**/*.bin
/whisper.cpp/
/faster-whisper-models/

# --- Sidecar binaries ---
/bin/
/sidecars/
*.exe
!**/scripts/**/*.exe

# --- Logs & temp ---
logs/
*.log
tmp/
temp/
.tmp/
*.tmp

# --- Test / coverage ---
coverage/
.nyc_output/
lcov.info
htmlcov/

# --- Archives ---
*.zip
*.7z
*.rar
*.tar
*.tar.gz
.direnv/
.fleet/
