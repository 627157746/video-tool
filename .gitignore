# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Editors / IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# --- Env & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# App local config that may contain API keys (keep examples tracked)
**/config.local.toml
**/config.local.json
**/*secret*
!**/*.example
!**/*.example.*

# --- Node / frontend (Tauri UI) ---
node_modules/
dist/
dist-ssr/
.output/
.vite/
.turbo/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Rust / Cargo ---
target/
**/*.rs.bk
Cargo.lock.bak

# --- Tauri ---
src-tauri/target/
src-tauri/gen/schemas/
# Generated WIX/NSIS artifacts
src-tauri/target/release/bundle/

# --- Python (if used for faster-whisper sidecar scripts) ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# --- Video-tool workspace & media (user data, large binaries) ---
# Runtime workspace (PRODUCT_SPEC: jobs live here)
workspace/
!workspace/.gitkeep

# Common media containers (do NOT use *.ts — conflicts with TypeScript)
*.mp4
*.mkv
*.webm
*.flv
*.m4a
*.mp3
*.wav
*.aac
*.mov
*.avi
*.m3u8
*.part
*.ytdl
# MPEG-TS only under media-ish paths (avoid ignoring src/**/*.ts)
*.mpegts
workspace/**/*.ts
**/jobs/**/*.ts
**/media/**/*.ts

# Runtime transcript/summary under jobs (docs/ stays tracked)
workspace/**/transcript/
workspace/**/summary/
**/jobs/**/transcript/
**/jobs/**/summary/

# --- ML models (large) ---
models/
*.gguf
*.onnx
*.pt
*.pth
*.safetensors
# Whisper/cpp weight dumps often end in .bin — scope under models only
models/**/*.bin
whisper.cpp/
faster-whisper-models/

# --- Sidecar binaries dropped into the repo ---
/bin/
/sidecars/
*.exe
!**/scripts/**/*.exe

# --- Logs & temp ---
logs/
*.log
tmp/
temp/
.tmp/
*.tmp

# --- Test / coverage ---
coverage/
.nyc_output/
lcov.info
htmlcov/

# --- Misc ---
*.zip
*.7z
*.rar
*.tar
*.tar.gz
.direnv/
.fleet/
